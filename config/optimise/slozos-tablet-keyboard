#!/usr/bin/bash
# On-screen keyboard only while the Surface is a tablet.
#
# Plasma's on-screen keyboard (plasma-keyboard) costs ~260 MB of RAM for as
# long as it's enabled, but you only need it with the Type Cover / keyboard
# base detached. Follow KWin's tablet mode: enable the keyboard (KWin starts
# the process) in tablet mode, disable it (KWin stops the process) otherwise.
set -u

kwin_get() {  # kwin_get OBJECT INTERFACE PROPERTY → true|false
    gdbus call --session --dest org.kde.KWin --object-path "$1" \
        --method org.freedesktop.DBus.Properties.Get "$2" "$3" 2>/dev/null \
        | grep -o 'true\|false'
}

apply() {
    local tablet current
    tablet=$(kwin_get /org/kde/KWin org.kde.KWin.TabletModeManager tabletMode) || return
    current=$(kwin_get /VirtualKeyboard org.kde.kwin.VirtualKeyboard enabled) || return
    [[ "$tablet" == "$current" ]] && return
    gdbus call --session --dest org.kde.KWin --object-path /VirtualKeyboard \
        --method org.freedesktop.DBus.Properties.Set \
        org.kde.kwin.VirtualKeyboard enabled "<$tablet>" >/dev/null
}

# Wait for KWin's D-Bus interface after login
for _ in $(seq 30); do kwin_get /org/kde/KWin org.kde.KWin.TabletModeManager tabletMode >/dev/null && break; sleep 1; done
apply

# React to tablet-mode changes (Type Cover attached/detached)
gdbus monitor --session --dest org.kde.KWin --object-path /org/kde/KWin 2>/dev/null \
    | while read -r line; do
        [[ $line == *tabletMode* ]] && apply
      done
