#!/usr/bin/bash
# SlozOS per-login setup, driven by the profile slozos-hardware picked at boot
# (/run/slozos/profile: light on PCs with under ~7 GB of RAM, full otherwise).
#
#   • KDE Connect + XWayland video bridge: start at login on "full" PCs,
#     on demand (when opened) on "light" ones
#   • Steam at login: the user's choice in SlozOS Welcome wins; without one,
#     "full" PCs start it, "light" PCs don't
#   • Prism Launcher's Java heap: sized to this PC's RAM, once
#   • 1.4.1/1.4.2: one-time moves for older accounts (MacTahoe, per-PC effects)
set -u
PROFILE=$(cat /run/slozos/profile 2>/dev/null || echo full)
PREF="${XDG_CONFIG_HOME:-$HOME/.config}/slozos"
mkdir -p "$PREF"

run_exec_of() {  # start the Exec= line of a (hidden) autostart entry
    [[ -f $1 ]] || return 1
    local cmd; cmd=$(grep -m1 '^Exec=' "$1" | cut -d= -f2- | sed 's/ %[a-zA-Z]//g')
    [[ -n $cmd ]] || return 1
    setsid bash -c "$cmd" >/dev/null 2>&1 &
}

if [[ $PROFILE == full ]]; then
    for f in /etc/xdg/autostart/*kdeconnect*daemon*.desktop /etc/xdg/autostart/*xwaylandvideobridge*.desktop; do
        run_exec_of "$f"
    done
fi

choice=$(cat "$PREF/steam-at-login" 2>/dev/null)
if [[ $choice == on || ( -z $choice && $PROFILE == full ) ]]; then
    run_exec_of "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/steam.desktop" \
        || { command -v steam >/dev/null && setsid steam -silent >/dev/null 2>&1 & }
fi

CFG="$HOME/.var/app/org.prismlauncher.PrismLauncher/data/PrismLauncher/prismlauncher.cfg"
if [[ -f $CFG && ! -f $PREF/prism-heap-set ]] && grep -q '^MaxMemAlloc=2048$' "$CFG"; then
    MEM_GB=$(( $(awk '/^MemTotal:/ {print $2}' /proc/meminfo) / 1024 / 1024 ))
    if   (( MEM_GB >= 15 )); then HEAP=4096
    elif (( MEM_GB >= 7  )); then HEAP=3072
    else                          HEAP=2048; fi
    sed -i "s/^MaxMemAlloc=2048$/MaxMemAlloc=$HEAP/" "$CFG"
    touch "$PREF/prism-heap-set"
fi

# SlozOS 1.4.1 replaced the WhiteSur themes with MacTahoe; WhiteSur is no longer
# installed, so accounts still pointing at it are switched over (once)
C="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ ! -f $PREF/mactahoe-migrated ]] && grep -qs WhiteSur "$C/kdeglobals" "$C/plasmarc" "$C/kwinrc" "$C/kcminputrc" "$C/Kvantum/kvantum.kvconfig"; then
    kwriteconfig6 --file kdeglobals --group Icons --key Theme MacTahoe-dark
    command -v /usr/libexec/plasma-changeicons >/dev/null && /usr/libexec/plasma-changeicons MacTahoe-dark
    plasma-apply-desktoptheme MacTahoe-Dark >/dev/null 2>&1
    plasma-apply-cursortheme MacTahoe-dark-cursors >/dev/null 2>&1
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme __aurorae__svg__MacTahoe-Dark
    mkdir -p "$C/Kvantum"; kwriteconfig6 --file "$C/Kvantum/kvantum.kvconfig" --group General --key theme MacTahoeDark
    for f in "$C/gtk-3.0/settings.ini" "$C/gtk-4.0/settings.ini"; do
        [[ -f $f ]] && sed -i -e 's/WhiteSur-\(dark-\)\{0,1\}cursors/MacTahoe-dark-cursors/' \
                              -e 's/WhiteSur-[A-Za-z-]*/MacTahoe-dark/' "$f"
    done
    qdbus-qt6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
    touch "$PREF/mactahoe-migrated"
fi

# SlozOS 1.4.2: blur, contrast and magic lamp became per-PC defaults (off when
# there's no 3D GPU, see slozos-hardware). Accounts made earlier carry a copy
# of the old "always on" values that would override that; drop it once.
if [[ ! -f $PREF/effects-per-pc ]]; then
    for k in blurEnabled contrastEnabled magiclampEnabled; do
        [[ $(kreadconfig6 --file kwinrc --group Plugins --key "$k") == true ]] \
            && kwriteconfig6 --file kwinrc --group Plugins --key "$k" --delete
    done
    qdbus-qt6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
    touch "$PREF/effects-per-pc"
fi
