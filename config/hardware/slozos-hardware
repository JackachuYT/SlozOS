#!/usr/bin/bash
# SlozOS hardware setup — runs early on every boot.
#
# SlozOS 1.4 runs on any PC, so device-specific fixes are applied here, only
# on the hardware that needs them, instead of being baked into every install.
# It also picks the performance profile (see slozos-session):
#
#   light — under ~7 GB of RAM: Steam, KDE Connect and the XWayland video
#           bridge start on demand; lighter glass blur
#   full  — everything at login, full effects
#
# and the graphics mode (see the Graphics section)
#
# Writes only to /run (fresh each boot), /etc/xdg/kwinrc (effect defaults) and
# /etc/xdg/powerdevilrc (Surface Pro 1/2 lid).
set -uo pipefail

dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null; }
LID_FIX=false
VENDOR=$(dmi sys_vendor)
PRODUCT=$(dmi product_name)
echo "Hardware: ${VENDOR:-?} ${PRODUCT:-?}"

MARVELL=false
has_marvell_wifi() {  # USB 1286:* or PCIe 11ab:* network devices
    $MARVELL && return 0
    grep -qsx '1286' /sys/bus/usb/devices/*/idVendor && return 0
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/vendor" 2>/dev/null) == 0x11ab && $(cat "$d/class" 2>/dev/null) == 0x0280* ]] && return 0
    done
    return 1
}

deep_sleep() {  # prefer S3 when the firmware offers it
    grep -qw deep /sys/power/mem_sleep 2>/dev/null && echo deep > /sys/power/mem_sleep && echo "Sleep: deep"
}

# ── Microsoft Surface ────────────────────────────────────────────────────────
if [[ $VENDOR == Microsoft* ]]; then
    case "$PRODUCT" in
        "Surface with Windows 8 Pro"|"Surface Pro"|"Surface Pro 2")
            # SP1/SP2 firmware reports a bogus "lid closed" after resume, which
            # loops suspend forever. Ignore the lid switch on these models.
            mkdir -p /run/systemd/logind.conf.d
            printf '[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n' \
                > /run/systemd/logind.conf.d/10-slozos-surface-lid.conf
            echo "Surface Pro 1/2: lid-switch fix on"
            LID_FIX=true; MARVELL=true; deep_sleep ;;
        "Surface Book")
            MARVELL=true; deep_sleep ;;
    esac
fi

# Plasma's power manager (PowerDevil) handles the lid itself inside a session —
# it holds logind's lid inhibitor, so the logind setting above only covers the
# login screen. Without this, waking an SP1/SP2 sees "lid closed" and sleeps
# again straight away, forever. System-wide default; a user's own choice wins.
for profile in AC Battery LowBattery; do
    if $LID_FIX; then
        kwriteconfig6 --file /etc/xdg/powerdevilrc --group "$profile" --group SuspendAndShutdown --key LidAction 0
    else   # this disk may have come from an SP1/SP2: put the default back
        kwriteconfig6 --file /etc/xdg/powerdevilrc --group "$profile" --group SuspendAndShutdown --key LidAction --delete
    fi
done 2>/dev/null

# Marvell Wi-Fi drops off when it power-saves; keep it awake (any PC)
if has_marvell_wifi; then
    mkdir -p /run/NetworkManager/conf.d
    printf '[connection]\nwifi.powersave = 2\n' > /run/NetworkManager/conf.d/10-slozos-marvell-powersave.conf
    echo "Marvell Wi-Fi: power saving off"
fi

# ── Performance profile ──────────────────────────────────────────────────────
MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
if (( MEM_KB < 7 * 1024 * 1024 )); then PROFILE=light; else PROFILE=full; fi

# ── Graphics ─────────────────────────────────────────────────────────────────
# Read from PCI (always there this early) rather than DRM, which appears only
# once the GPU driver has loaded.
#   hardware — a real GPU (Intel/AMD/NVIDIA) or a VM with 3D (virtio-gpu virgl)
#   software — a VM display without 3D: everything is drawn by the CPU
#              (llvmpipe), so the glass effects are switched off
BLUR=10
GRAPHICS=software
for d in /sys/bus/pci/devices/*; do
    [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
    vendor=$(cat "$d/vendor" 2>/dev/null)
    case "$vendor" in
        0x8086)
            GRAPHICS=hardware
            case "$(cat "$d/device" 2>/dev/null)" in   # lighter blur on old iGPUs
                0x01*)                         (( BLUR > 6 )) && BLUR=6 ;;   # Sandy/Ivy Bridge
                0x04*|0x0a*|0x0d*|0x16*|0x19*) (( BLUR > 8 )) && BLUR=8 ;;   # Haswell → Skylake
            esac ;;
        0x10de|0x1002) GRAPHICS=hardware; DISCRETE=true ;;
        0x1af4) # virtio-gpu: 3D only when the host offers virgl, which is
                # feature bit 0 (VIRTIO_GPU_F_VIRGL) of the virtio device. (A
                # render node alone proves nothing: it exists without 3D too.)
            for _ in $(seq 30); do
                for v in /sys/bus/virtio/devices/*; do
                    [[ $(cat "$v/device" 2>/dev/null) == 0x0010 ]] || continue
                    [[ $(cut -c1 "$v/features" 2>/dev/null) == 1 ]] && GRAPHICS=hardware
                    break 2
                done
                sleep 0.1
            done ;;
    esac
done
[[ ${DISCRETE:-false} == true ]] && BLUR=10        # a discrete GPU wins
[[ $PROFILE == light && $BLUR -gt 8 ]] && BLUR=8

mkdir -p /run/slozos
echo "$PROFILE"  > /run/slozos/profile
echo "$GRAPHICS" > /run/slozos/graphics
# System-wide defaults (a user's own settings still win)
kw() { kwriteconfig6 --file /etc/xdg/kwinrc --group "$1" --key "$2" "$3" 2>/dev/null \
           || printf '[%s]\n%s=%s\n' "$1" "$2" "$3" >> /etc/xdg/kwinrc; }
kw Effect-blur BlurStrength "$BLUR"
GLASS=$([[ $GRAPHICS == hardware ]] && echo true || echo false)
kw Plugins blurEnabled      "$GLASS"
kw Plugins contrastEnabled  "$GLASS"
kw Plugins magiclampEnabled "$GLASS"
echo "Profile: $PROFILE ($(( MEM_KB / 1024 )) MB RAM), graphics $GRAPHICS, blur $BLUR"
