# Marvell 88W87xx USB Wi-Fi/Bluetooth (Surface Pro 1/2 and others).
# USB autosuspend knocks this adapter offline until reboot, so keep it powered.
# Matches only these USB IDs, so it's harmless on every other PC.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1286", ATTR{idProduct}=="2044", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1286", ATTR{idProduct}=="2032", TEST=="power/control", ATTR{power/control}="on"
