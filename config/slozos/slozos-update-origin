#!/usr/bin/bash
# Point this install at SlozOS's own update images.
#
# The ISO installs SlozOS from an image embedded on the USB stick, so a fresh
# install's update source is that (unreachable) local image. On first boot,
# record ghcr.io/jackachuyt/slozos-<edition>:stable instead — without
# downloading anything. Installs that already track a SlozOS image (e.g. via
# `slozos-update channel 1.3`) are left alone.
#
# Two ways to do it, because 1.2's first try (bootc alone) failed on real
# installs:
#   1. bootc switch --mutate-in-place      (the supported way)
#   2. edit the booted deployment's .origin (what (1) does under the hood;
#      rpm-ostree and bootc both read container-image-reference from it)
set -uo pipefail

WANT=$(cat /usr/share/slozos/image-ref)            # ghcr.io/jackachuyt/slozos-sp2:stable
REPO=${WANT%%:*}
WANT_REF="ostree-unverified-registry:$WANT"

current_ref() {
    rpm-ostree reload >/dev/null 2>&1 || true      # don't trust the daemon's cache
    rpm-ostree status --booted --json 2>/dev/null \
        | jq -r '.deployments[0]["container-image-reference"] // empty'
}

done_ok() {
    mkdir -p /var/lib/slozos && touch /var/lib/slozos/update-origin-set
    echo "Update source: $(current_ref)"
    exit 0
}

CURRENT=$(current_ref)
echo "Current update source: ${CURRENT:-unknown}"
case "$CURRENT" in
    *"$REPO":*|*"$REPO") echo "Already on SlozOS updates."; done_ok ;;
esac

echo "Switching update source to $WANT"
if bootc switch --mutate-in-place --transport registry "$WANT"; then
    [[ "$(current_ref)" == *"$REPO"* ]] && done_ok
    echo "bootc reported success but the source didn't change; trying the fallback" >&2
else
    echo "bootc switch --mutate-in-place failed; trying the fallback" >&2
fi

DEPLOY_DIR=$(ostree admin --print-current-dir)     # /sysroot/ostree/deploy/<os>/deploy/<csum>.<n>
ORIGIN="$DEPLOY_DIR.origin"
if [[ ! -f "$ORIGIN" ]]; then
    echo "Can't find the deployment origin file ($ORIGIN)" >&2
    exit 1
fi
# /sysroot is read-only; remount it writable only inside this process's own
# mount namespace.
unshare -m sh -c '
    set -e
    mount -o remount,rw /sysroot
    sed -i "s|^container-image-reference=.*|container-image-reference=$1|" "$2"
    grep -q "^container-image-reference=" "$2" || printf "container-image-reference=%s\n" "$1" >> "$2"
' sh "$WANT_REF" "$ORIGIN" || { echo "Couldn't update $ORIGIN" >&2; exit 1; }

[[ "$(current_ref)" == *"$REPO"* ]] && done_ok
echo "Update source still not SlozOS after fallback" >&2
exit 1
