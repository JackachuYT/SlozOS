[Unit]
Description=Point SlozOS at its own update images
ConditionPathExists=!/var/lib/slozos/update-origin-v2
After=local-fs.target
Before=uupd.service uupd.timer

[Service]
Type=oneshot
ExecStart=/usr/libexec/slozos-update-origin
RemainAfterExit=yes
# Also print to the console, so boot logs show what happened
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
