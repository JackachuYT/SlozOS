[Environment]
# Threaded OpenGL: moves Mesa's driver work off Minecraft's render thread.
# Vanilla Minecraft is CPU/driver-bound on Intel HD 4000/4400/520, so this is
# one of the biggest free FPS wins there.
mesa_glthread=true
# NVIDIA equivalent (Surface Book 1's GTX 940M)
__GL_THREADED_OPTIMIZATIONS=1
