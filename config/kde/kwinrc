# SlozOS KWin defaults — macOS-style window chrome and effects.

[org.kde.kdecoration2]
# MacTahoe (dark) Aurorae decoration: macOS 26/27 traffic-light buttons on the left
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MacTahoe-Dark
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false

[Plugins]
blurEnabled=true
contrastEnabled=true
# macOS "Genie"-style minimise
magiclampEnabled=true
squashEnabled=false
# Off: not macOS-like, and they cost GPU time on Haswell/Ivy Bridge iGPUs
wobblywindowsEnabled=false
diminactiveEnabled=false
translucencyEnabled=false

[Effect-blur]
# BlurStrength is set per GPU at boot (slozos-hardware → /etc/xdg/kwinrc)
NoiseStrength=3

[Effect-overview]
# No hot corner: the top-left corner holds the SlozOS menu, and a hot corner
# there fires every time you reach for it. Meta+W / three-finger swipe still work.
BorderActivate=9

[Windows]
ElectricBorderMaximize=true
ElectricBorderTiling=true
FocusPolicy=ClickToFocus

[TabBox]
# Cmd-Tab-style big-icon app switcher
LayoutName=big_icons
HighlightWindows=false
