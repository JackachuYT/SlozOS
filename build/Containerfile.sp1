# BASE: the SlozOS base image (CI passes ghcr.io/jackachuyt/slozos-base-sp1:<key>).
# Defaults to plain Bazzite, in which case the base layer is built inline below.
ARG BASE=ghcr.io/ublue-os/bazzite:stable

# ── Stage 1: build SlozOS's own apps (Spotlight, Updater) ────────────────────
# Same image as the OS below, so they link against the same Qt/KDE versions.
FROM ${BASE} AS apps
RUN --mount=type=bind,source=.,target=/ctx bash /ctx/build/build-apps.sh

# ── Stage 2: the OS image ────────────────────────────────────────────────────
FROM ${BASE}

# ── Base layer: packages, WhiteSur themes, boot splash ──────────────────────
# Already present when BASE is the published SlozOS base image (CI); built
# here for plain local builds FROM Bazzite.
RUN --mount=type=bind,source=.,target=/ctx \
    [ -f /usr/share/slozos/.base-layer ] || bash /ctx/build/slozos-base.sh

# ── Microsoft Surface Pro 1 (2013, Ivy Bridge) ───────────────────────────────
# CPU   : Intel Core i5-3317U (Ivy Bridge)
# GPU   : Intel HD Graphics 4000 — i915 (in-kernel)
# WiFi  : Marvell AVASTAR USB (88W8764/88W8797) — mwifiex_usb (in-kernel)
# BT    : Same Marvell combo chip — btusb (in-kernel)
# Touch : hid-multitouch + wacom (in-kernel)
# Audio : Intel HDA — snd_hda_intel (in-kernel)
# Cameras: ✅ Both cameras work via uvcvideo (in-kernel)
# ✗ Performance Modes not supported

# ── Surface Pro 1 hardware quirk fixes ───────────────────────────────────────
COPY config/surface-pro1/81-mwifiex-no-autosuspend.rules /usr/lib/udev/rules.d/81-mwifiex-no-autosuspend.rules
COPY config/surface-pro1/mwifiex.conf                    /usr/lib/modprobe.d/mwifiex.conf
COPY config/surface-pro1/wifi-powersave.conf             /usr/lib/NetworkManager/conf.d/wifi-powersave.conf
COPY config/surface-pro1/10-surface-lid.conf             /usr/lib/systemd/logind.conf.d/10-surface-lid.conf
COPY config/surface-pro1/01-sp1-kargs.toml               /usr/lib/bootc/kargs.d/01-sp1-kargs.toml

# SlozOS Spotlight + SlozOS Updater from stage 1; --help proves they link
COPY --from=apps /out/usr/ /usr/
RUN QT_QPA_PLATFORM=offscreen slozos-spotlight --help >/dev/null && \
    QT_QPA_PLATFORM=offscreen bazzite-updater --help >/dev/null

# ── SlozOS settings: Liquid Glass desktop, branding, updates, tuning ────────
# Shared by all editions — see build/slozos-desktop.sh.
RUN --mount=type=bind,source=.,target=/ctx \
    SLOZOS_HOSTNAME="slozos-sp1" \
    SLOZOS_NAME="SlozOS SP1" \
    SLOZOS_PRETTY_NAME="SlozOS 1.2.2 SP1 (Bazzite)" \
    SLOZOS_VERSION="1.2.2" \
    SLOZOS_EDITION="Surface Pro 1" \
    SLOZOS_IMAGE="ghcr.io/jackachuyt/slozos-sp1" \
    bash /ctx/build/slozos-desktop.sh


LABEL org.opencontainers.image.title="SlozOS SP1"
LABEL org.opencontainers.image.description="SlozOS — Bazzite gaming OS for Microsoft Surface Pro 1"
LABEL org.opencontainers.image.source="https://github.com/JackachuYT/SlozOS"
LABEL org.opencontainers.image.version="1.2.2"
