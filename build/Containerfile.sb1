# BASE: the SlozOS base image (CI passes ghcr.io/jackachuyt/slozos-base-sb1:<key>).
# Defaults to plain Bazzite, in which case the base layer is built inline below.
ARG BASE=ghcr.io/ublue-os/bazzite-nvidia:stable

# ── Stage 1: build SlozOS's own apps (Spotlight, Updater) ────────────────────
# Same image as the OS below, so they link against the same Qt/KDE versions.
FROM ${BASE} AS apps
RUN --mount=type=bind,source=.,target=/ctx bash /ctx/build/build-apps.sh

# ── Stage 2: the OS image ────────────────────────────────────────────────────
FROM ${BASE}

# ── Base layer: packages, WhiteSur themes, boot splash ──────────────────────
# Already present when BASE is the published SlozOS base image (CI); built
# here for plain local builds FROM Bazzite.
RUN --mount=type=bind,source=.,target=/ctx \
    [ -f /usr/share/slozos/.base-layer ] || bash /ctx/build/slozos-base.sh

# ── Microsoft Surface Book 1 (2015, Skylake) ─────────────────────────────────
# CPU   : Intel Core i5-6300U / i7-6600U (Skylake)
# iGPU  : Intel HD Graphics 520 — i915 (in-kernel)
# dGPU  : NVIDIA GeForce GTX 940M — nvidia driver (in bazzite-nvidia)
#          In the keyboard base; available when clipboard is attached.
#          PRIME render offload lets games pick GPU on demand.
# WiFi  : Marvell AVASTAR 88W8897 (PCIe) — mwifiex_pcie (in-kernel)
# BT    : Same Marvell combo chip — btusb (in-kernel)
# Touch : surface_aggregator patches (in kernel-bazzite)
# Detach: surface_book_power handles clipboard detach (in kernel-bazzite)
# ✗ Performance Modes not supported
# ? Cameras: status unclear (linux-surface footnote 10)

# ── Surface Book 1 hardware quirk fixes ──────────────────────────────────────
COPY config/surface-book/mwifiex.conf        /usr/lib/modprobe.d/mwifiex.conf
COPY config/surface-book/wifi-powersave.conf /usr/lib/NetworkManager/conf.d/wifi-powersave.conf
COPY config/surface-book/01-sb1-kargs.toml   /usr/lib/bootc/kargs.d/01-sb1-kargs.toml

# SlozOS Spotlight + SlozOS Updater from stage 1; --help proves they link
COPY --from=apps /out/usr/ /usr/
RUN QT_QPA_PLATFORM=offscreen slozos-spotlight --help >/dev/null && \
    QT_QPA_PLATFORM=offscreen bazzite-updater --help >/dev/null

# ── SlozOS settings: Liquid Glass desktop, branding, updates, tuning ────────
# Shared by all editions — see build/slozos-desktop.sh.
RUN --mount=type=bind,source=.,target=/ctx \
    SLOZOS_HOSTNAME="slozos-sb1" \
    SLOZOS_NAME="SlozOS SB1" \
    SLOZOS_PRETTY_NAME="SlozOS 1.2.3 SB1 (Bazzite)" \
    SLOZOS_VERSION="1.2.3" \
    SLOZOS_EDITION="Surface Book 1" \
    SLOZOS_IMAGE="ghcr.io/jackachuyt/slozos-sb1" \
    bash /ctx/build/slozos-desktop.sh


LABEL org.opencontainers.image.title="SlozOS SB1"
LABEL org.opencontainers.image.description="SlozOS — Bazzite gaming OS for Microsoft Surface Book 1"
LABEL org.opencontainers.image.source="https://github.com/JackachuYT/SlozOS"
LABEL org.opencontainers.image.version="1.2.3"
